NODE_ENV=production
TZ=Europe/Paris

# Database
DATABASE_URL="postgresql://polis:polis@db-polis:5432/polis"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-33"
AUTH_URL="https://polis.somi.blaisot.org"
AUTH_TRUST_HOST=true

# GitHub OAuth App (github.com/settings/developers) — callback URL must be
# <AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID="your-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-oauth-app-client-secret"

# Shared secret required by POST /api/cities/refresh (cron-driven cache refresh)
REFRESH_SECRET="generate-a-random-secret"
