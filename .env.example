NODE_ENV=production
TZ=Europe/Paris

# Database
DATABASE_URL="postgresql://polis:polis@db-polis:5432/polis"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with-openssl-rand-base64-33"
AUTH_URL="https://polis.somi.blaisot.org"
AUTH_TRUST_HOST=true

# GitHub OAuth App (github.com/settings/developers), callback URL must be
# <AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID="your-oauth-app-client-id"
GITHUB_CLIENT_SECRET="your-oauth-app-client-secret"

# Optional. A real sign-in authenticates its own GitHub API calls with that
# user's own OAuth token, but NODE_ENV=development's local dev sign-in
# (skips OAuth entirely) has none, and city generation alone can be 100+
# requests, easily over GitHub's unauthenticated limit (60/hour per IP).
# Set this to any GitHub personal access token (no scopes needed, only
# public data is ever read) to raise it to 5000/hour for local testing.
# GITHUB_TOKEN="your-personal-access-token"

# Shared secret required by POST /api/cities/refresh (cron-driven cache refresh)
REFRESH_SECRET="generate-a-random-secret"
